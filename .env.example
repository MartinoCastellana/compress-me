# Hostname/IP dello storage locale visto dal container, separati da virgola.
ALLOWED_STORAGE_HOSTS=host.docker.internal,192.168.1.10
ALLOWED_STORAGE_PORTS=80,443,8080,8443

# IP o CIDR dei client autorizzati a chiamare l'API.
ALLOWED_CLIENT_IPS=127.0.0.1/32,192.168.1.0/24
# Aggiungere una API key come seconda barriera, opzionale ma raccomandata.
API_KEY=change-me
TRUST_PROXY_HEADERS=false

MAX_DOWNLOAD_BYTES=262144000
DATA_DIR=/data/jobs
